# Copy to .env and fill in secrets. Never commit the real file (it is gitignored).

SOLANA_CLUSTER=devnet                                    # devnet | localnet; which Solana cluster the service and scripts target
SOLANA_RPC_URL=https://api.devnet.solana.com              # JSON-RPC endpoint for the chosen cluster
SOLANA_WS_URL=wss://api.devnet.solana.com                 # websocket endpoint for account subscriptions
ADMIN_KEYPAIR_PATH=/run/keys/admin.json                   # path (inside the container) to the admin signer keypair; read-only mount -- `--create-keys` writes new keys to repo-relative keys/ instead
PUBLISHER_KEYPAIR_PATH=/run/keys/publisher.json           # path (inside the container) to the mock-oracle publisher keypair; read-only mount -- `--create-keys` writes new keys to repo-relative keys/ instead
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU     # collateral SPL mint; Circle devnet USDC by default
ORACLE_PROVIDER=mock                                      # mock | pyth; must agree with Config.oracle_provider on chain
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes         # Hermes base URL for Pyth price updates
# bearer token for Hermes price endpoints; also read by the web app's server-side /api/prices route (falls back to /run/keys/pyth_api_key)
PYTH_API_KEY=
PYTH_RECEIVER_PROGRAM=rec5EKMGg6MxZYaMdyBfgwp4d5rB9T1VQH5pJv5LtFJ  # devnet Pyth receiver program id
# Finnhub API key for the mock provider's price sources
FINNHUB_API_KEY=
# webhook POSTed when settlement retries exhaust the 15-minute window
ALERT_WEBHOOK_URL=
AUTOMATION_STATUS_PORT=8787                                # port the automation service's GET /status endpoint listens on
WEB_ORIGIN=http://localhost:3000        # browser origin allowed to read the automation status endpoint
WEB_PORT=3000                                              # host port (127.0.0.1) bound to the container's web dev server
RPC_PORT=8899                                              # host port (127.0.0.1) bound to the container's validator RPC
WS_PORT=8900                                               # host port (127.0.0.1) bound to the container's validator websocket
STATUS_PORT=8787                                           # host port (127.0.0.1) bound to the container's automation status endpoint
DEMO_SCALE=1                                              # 1 = book capacity 16 (fits one airdrop); 0 = capacity 128
NEXT_PUBLIC_CLUSTER=devnet                                # cluster shown/used by the web app
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com         # JSON-RPC endpoint used by the browser client; a private endpoint (Alchemy/QuickNode/Helius free tier) avoids the public 429s
NEXT_PUBLIC_WS_URL=wss://api.devnet.solana.com            # websocket endpoint used by the browser client
# deployed Meridian program id, filled in after `make deploy`
NEXT_PUBLIC_PROGRAM_ID=
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU  # collateral mint shown/used by the web app
NEXT_PUBLIC_RPC_TX_FETCH_SPACING_MS=600                   # pause between history transaction fetches; 600 suits the public RPC (40 calls/method/10 s), 200 a private endpoint
NEXT_PUBLIC_AUTOMATION_STATUS_URL=http://localhost:8787/status      # where the admin page reads settlement status from
BIND_HOST=127.0.0.1    # host interface for published ports; 0.0.0.0 to reach the app from other machines
PUBLIC_HOST=127.0.0.1  # host/IP the browser uses to reach the local validator when BIND_HOST is 0.0.0.0
