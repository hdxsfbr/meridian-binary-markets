{
  "name": "@meridian/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node.ts",
      "default": "./src/node.ts"
    },
    "./src/*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "imports": {
    "#book": "./src/book.ts",
    "#events": "./src/events.ts",
    "#idl": "./src/idl.ts",
    "#intent": "./src/intent.ts",
    "#pda": "./src/pda.ts",
    "#pnl": "./src/pnl.ts",
    "#program-id": "./src/program-id.ts",
    "#strikes": "./src/strikes.ts",
    "#types": "./src/types.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@anchor-lang/core": "1.2.1",
    "@solana/web3.js": "^1.99.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
